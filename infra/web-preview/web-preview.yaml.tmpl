---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pr-preview-${PR}
  namespace: web-preview
  labels:
    app.kubernetes.io/name: frontend
    app.kubernetes.io/instance: pr-${PR}
    app.kubernetes.io/component: web
    app.kubernetes.io/managed-by: manual
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: frontend
      app.kubernetes.io/instance: pr-${PR}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: frontend
        app.kubernetes.io/instance: pr-${PR}
        app.kubernetes.io/component: web
        app.kubernetes.io/managed-by: manual
    spec:
      imagePullSecrets:
        - name: ghcr-pull
      containers:
        - name: pr-preview-${PR}
          image: ${FRONTEND_IMAGE}
          imagePullPolicy: Always
          ports:
            - containerPort: 3000
              name: http
          resources:
            requests: { cpu: 50m, memory: 128Mi }
            limits:   { cpu: 500m, memory: 512Mi }
          readinessProbe:
            httpGet: { path: /, port: 3000 }
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /, port: 3000 }
            initialDelaySeconds: 15
            periodSeconds: 30
---
apiVersion: v1
kind: Service
metadata:
  name: pr-preview-${PR}
  namespace: web-preview
  labels:
    app.kubernetes.io/name: frontend
    app.kubernetes.io/instance: pr-${PR}
    app.kubernetes.io/component: web
    app.kubernetes.io/managed-by: manual
spec:
  selector:
    app.kubernetes.io/name: frontend
    app.kubernetes.io/instance: pr-${PR}
  ports:
    - name: http
      port: 3000
      targetPort: 3000
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: pr-preview-${PR}
  namespace: web-preview
  labels:
    app.kubernetes.io/name: frontend
    app.kubernetes.io/instance: pr-${PR}
    app.kubernetes.io/component: web
    app.kubernetes.io/managed-by: manual
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  rules:
    - host: pr-${PR}.preview.kolchurin.dev
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: pr-preview-${PR}
                port:
                  number: 3000
